<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>

        <!-- Koneksi Database MySQL -->
        <property name="hibernate.connection.driver_class">
            com.mysql.cj.jdbc.Driver
        </property>

        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/Idan
        </property>

        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password"></property>

        <!-- Dialect MySQL -->
        <property name="hibernate.dialect">
            org.hibernate.dialect.MySQLDialect
        </property>

        <!-- Pengaturan Hibernate -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">update</property>
        
        <mapping class="com.mycompany.idan.model.Akun"/>
        <!-- Entity Pelanggan dan Pesanan -->
        <mapping class="com.mycompany.idan.model.Pelanggan"/>
        <mapping class="com.mycompany.idan.model.Pesanan"/>

        <!-- Entity Layanan dan turunannya -->
        <mapping class="com.mycompany.idan.model.Layanan"/>
        <mapping class="com.mycompany.idan.model.CleanBuild"/>
        <mapping class="com.mycompany.idan.model.PanelLine"/>
        <mapping class="com.mycompany.idan.model.TopCoat"/>
        <mapping class="com.mycompany.idan.model.Decal"/>
        
    </session-factory>
</hibernate-configuration>
